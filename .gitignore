# Data — never commit (Q8 policy)
#
# Leading slash is load-bearing: a bare `data/` matches at ANY depth and
# silently swallowed src/data/ (the readers, schema and extractor were left
# untracked for a whole commit). Anchor it to the repo root.
/data/
*.zip
*.parquet

# Models / checkpoints
*.pt
*.ckpt
*.bin
*.safetensors

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# OS / editor
.DS_Store
