# Data — never commit (Q8 policy)
#
# Leading slash is load-bearing: a bare `data/` matches at ANY depth and
# silently swallowed src/data/ (the readers, schema and extractor were left
# untracked for a whole commit). Anchor it to the repo root.
/data/
*.zip
*.parquet

# Models / checkpoints
*.pt
*.ckpt
*.bin
*.safetensors

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# OS / editor
.DS_Store

# Prediction files -- hundreds of MB of text, regenerable in ~15 min by
# `make submit`. Q8 bars large files. The .meta.json beside each IS tracked:
# it records the retriever, params, line count and budget that produced the
# file, which is what makes a leaderboard score traceable.
submissions/*.txt
submissions/*.zip

# LaTeX build artefacts -- the .tex and .pdf are tracked, the rest is derived.
report/*.aux
report/*.log
report/*.out
report/*.toc

# Embedding cache -- regenerable in ~15s by re-running; keyed on model+corpus.
data/store/embeddings/

# Backup of the superseded bm25-only submission
submissions/*.bak
submissions/*_prediction.txt
